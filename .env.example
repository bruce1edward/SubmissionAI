# Explicit development mode. This is not an Atlas-backed hackathon entry.
STORAGE_BACKEND=sqlite
REVIEW_MODE=deterministic
DATA_DIR=.data

# Use the hackathon-provided sandbox. Change STORAGE_BACKEND to mongodb.
MONGODB_URI=
MONGODB_DATABASE=submissionai_continuity
MONGODB_VECTOR_INDEX=evidence_qwen3_4096

# Nebius Token Factory. Add a key and an available model, then run `python -m continuity check-llm`.
# Change REVIEW_MODE to llm after the live check passes, then restart the server.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
NEBIUS_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
LLM_API_STYLE=chat_completions
LLM_REASONING_EFFORT=
LLM_MAX_OUTPUT_TOKENS=2400
# LLM_API_KEY overrides NEBIUS_API_KEY; leave it empty when using the named Nebius key.
# For OpenAI, use its base URL, LLM_API_KEY, an OpenAI model, and LLM_API_STYLE=responses.

# Atlas Vector Search with the same Nebius key. Set up the index and run check-vector first.
VECTOR_SEARCH_ENABLED=false
EMBEDDING_PROVIDER=nebius
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSIONS=4096
# Optional alternative: EMBEDDING_PROVIDER=voyage, EMBEDDING_MODEL=voyage-3.5-lite,
# EMBEDDING_DIMENSIONS=1024, and a new MONGODB_VECTOR_INDEX name.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
VOYAGE_DIMENSIONS=1024

# Optional shared token for a private hosted demo. Leave blank for localhost only.
APP_ACCESS_TOKEN=

# Optional presentation filter and fictional drug display name. Blank shows all studies.
DEMO_STUDY_ID=
DEMO_DRUG_NAME=
